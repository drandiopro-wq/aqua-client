name: Build AquaClient DLL
on: [push, workflow_dispatch]

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - name: Clone Amethyst (1.21.0.3)
        run: git clone --depth 1 -b 1.21.0.3 https://github.com/FrederoxDev/Amethyst
      - uses: xmake-io/github-action-setup-xmake@v1
        with:
          xmake-version: latest
      - name: Build mod
        env:
          AMETHYST_SRC: ${{ github.workspace }}/Amethyst
        run: xmake -y
      - name: Upload mod folder (DLL + mod.json)
        uses: actions/upload-artifact@v4
        with:
          name: AquaClient-mod
          path: dist/**
          if-no-files-found: error
